#!/bin/bash
# Pre-commit gate: block commits that would leave RESULTS.md / leaderboard.html / audit/ out of sync with a
# fresh rebuild from outputs/. Mirrors akmaier/Agent4CT's registry gate. Install with:
#   bash hpc/install_hooks.sh   (sets git config core.hooksPath .githooks)
#
# Fires when a rendered view OR one of its inputs is staged: the views are rebuilt from outputs/ by
# code under src/ and hpc/ and also read CITATION.cff (page citation), pyproject.toml, env/*.lock,
# requirements*.lock (environment page), tests/ (provenance test count, gates-page line anchors),
# audit/ inputs (assets/manifest.json, provenance/*.json) and the manuscript mirror. (Triggering on the views alone let an input-only commit — e.g. a CITATION.cff
# author change — leave every page stale; see docs/internal/lessons.md 2026-09-29.) The checker
# itself skips cleanly where outputs/ is absent (dev machines / CI), so this never blocks unrelated work.
# It checks the STAGED views (--staged), so a partially staged --fix cannot ship stale files.
set -uo pipefail

staged="$(git diff --cached --name-only 2>/dev/null || true)"
if ! grep -qE '^(RESULTS\.md|leaderboard\.html|coverage_snapshot\.json|audit/.*|results/.*|paper/manuscript/.*|CITATION\.cff|pyproject\.toml|env/.*|requirements[^/]*\.lock|src/.*|hpc/.*|tests/.*)$' <<<"$staged"; then
  exit 0
fi

# Machine profile first (caller-wins `:=` defaults, so an explicit $PY survives), then a
# generic python as the last resort.
if [ -f "hpc/clusters/local.env" ]; then
  # shellcheck disable=SC1091
  source "hpc/clusters/local.env"
fi
if [ -z "${PY:-}" ]; then
  for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi

if ! "$PY" hpc/check_results_fresh.py --staged; then
  echo
  echo "pre-commit: the freshness gate failed. Either the results views are stale" >&2
  echo "  (regenerate with: \$PY hpc/check_results_fresh.py --fix, stage, re-commit)" >&2
  echo "  or \$PY ('$PY') cannot import the repo deps — set PY or create" >&2
  echo "  hpc/clusters/local.env (see hpc/clusters/alex.env)." >&2
  echo "  (bypass for a one-off with: git commit --no-verify — discouraged)" >&2
  exit 1
fi
exit 0
