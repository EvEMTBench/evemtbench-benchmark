# Cluster profile: NHR@FAU Alex (login alex[12].nhr.fau.de) — the default.
#
# Sourced by hpc/submit.sh and hpc/sweep.sh when CLUSTER=alex (the default). Sets per-cluster
# defaults with `: "${VAR:=...}"` so an explicit env var from the caller ALWAYS wins. This file only
# encodes what differs between clusters; the sweep machinery (coverage, staging, CHAIN, soft-deadline)
# is cluster-agnostic. (Federation design notes live in the development repo.)
#
# Alex is GPU-only: EVERY allocation gets a GPU (no cpu partition), the partition is selected from the
# gres (no explicit -p), and GPU jobs FORBID --mem (you get a proportional per-GPU host-RAM share).
# CPU-only classical baselines are routed to a MIG a100small slice so they never hold a full A40.

# Machine-local truth (data root, interpreter, W&B entity, shared pools) lives in the UNTRACKED
# sibling local.env — sourced first so its defaults apply; an explicit env var still wins.
# NB callers run set -e: local.env must end with a status-0 statement (the `: "${VAR:=...}"` +
# export idiom does) or sourcing it kills the caller.
_cluster_dir="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck disable=SC1091
if [ -f "$_cluster_dir/local.env" ]; then source "$_cluster_dir/local.env"; fi

: "${DEFAULT_GRES:=gpu:a40:1}"          # full A40 for deep baselines; GRES= overrides
: "${DEFAULT_PARTITION:=}"              # empty -> gres selects the partition (no -p on Alex)
: "${SUPPORTS_MIG:=1}"                  # classical CPU-only baselines -> MIG slice (audit F1)
: "${MIG_GRES:=gpu:a100small:1}"
: "${MIG_PARTITION:=a100mig}"
: "${MIG_CPUS:=8}"                      # --cpus-per-task for classical MIG jobs (rf n_jobs=-1 adapts)
: "${USE_MEM:=0}"                       # Alex GPU jobs must NOT pass --mem
: "${MEM:=}"
: "${CPUS_PER_TASK:=16}"                # matches sweep.sh's #SBATCH default (Alex ~16 cores/GPU)

# Environment activation (module -> conda). $WORK is set inside SLURM jobs; on the login node conda
# activate-by-name (CONDA_ENV) succeeds and the CONDA_ENV_PATH fallback is not needed.
: "${MODULE_CMD:=module load python}"
: "${CONDA_ENV:=py_dl}"
: "${CONDA_ENV_PATH:=$WORK/software/private/conda/envs/py_dl}"
