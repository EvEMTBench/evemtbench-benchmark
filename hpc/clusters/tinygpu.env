# Cluster profile: NHR@FAU TinyGPU (login tinyx) — the federation account.
#
# Sourced by hpc/submit.sh and hpc/sweep.sh when CLUSTER=tinygpu. Sets per-cluster defaults with
# `: "${VAR:=...}"` so an explicit env var from the caller ALWAYS wins.
#
# TinyGPU is GPU-only; its partitions are named by GPU TYPE and an explicit `-p <partition>` is
# REQUIRED to pick the type (unlike Alex, where the gres selects the partition). `sinfo` on tinyx:
#   rtx3080 (10 GB) · v100 (16-32 GB) · a100 (40/80 GB) · work* (default, any) — all 24 h wall.
# The federated sweep runs only the SMALL deep cells here (finding F4: models use <=3 GB), so the
# right-sized default is a single RTX 3080. Reserve TinyGPU's scarce a100 nodes; use v100 as overflow
# (GRES=gpu:v100:1 DEFAULT_PARTITION=v100). No MIG on TinyGPU — classical baselines belong on Alex.

# Machine-local truth (data root, interpreter, shared pools) lives in the UNTRACKED sibling
# local.env — sourced first so its defaults apply; an explicit env var still wins.
# NB callers run set -e: local.env must end with a status-0 statement (the `: "${VAR:=...}"` +
# export idiom does) or sourcing it kills the caller.
_cluster_dir="$(dirname "${BASH_SOURCE[0]}")"
# shellcheck disable=SC1091
if [ -f "$_cluster_dir/local.env" ]; then source "$_cluster_dir/local.env"; fi

: "${DEFAULT_GRES:=gpu:rtx3080:1}"      # 10 GB is 3x what these <=3 GB models need
: "${DEFAULT_PARTITION:=rtx3080}"       # REQUIRED on TinyGPU to select the GPU type
: "${SUPPORTS_MIG:=0}"                  # no MIG; do not run classical here (it would idle a GPU)
: "${MIG_GRES:=}"
: "${MIG_PARTITION:=}"
: "${USE_MEM:=0}"                       # proportional per-GPU share like Alex; set MEM= to override
: "${MEM:=}"
# CPUs per task — rtx3080 nodes have **8 cores/GPU**, so this MUST be 8 (sweep.sh hardcodes 16, which
# is wrong for TinyGPU; the TinyGPU worker had to inject --cpus-per-task=8 via a PATH-shim). 8 is the
# max without stranding GPUs. It still leaves the CPU-bound pipeline starved on wide grids (cigre) —
# the real fix is the projection cache (build on Alex → shared projcache), NOT more CPUs here.
: "${CPUS_PER_TASK:=8}"

# Federated held_out results go to a SHARED pool the reporting account can read (a TinyGPU $HOME
# is not reachable cross-account). TinyGPU runs only held_out, so default OUT to the shared pool
# when one is configured and present (an explicit OUT= still wins). Alex does NOT do this — its
# transfer track must stay repo-local ("two pools").
#
# FEDERATION BRING-UP (required once per TinyGPU clone): SHARED_OUT is machine truth and lives in
# the UNTRACKED hpc/clusters/local.env — a fresh clone does not have it, and WITHOUT it results
# are written to this account's repo-local outputs/, which the reporting account cannot reach
# (GPU time spent, results stranded). Create local.env with SHARED_OUT before submitting.
if [ -z "${SHARED_OUT:-}" ]; then
  echo "WARN: SHARED_OUT is unset (no hpc/clusters/local.env?) — results will land in the" >&2
  echo "      repo-local outputs/ of THIS account, unreachable by the reporting account." >&2
elif [ -d "$SHARED_OUT" ]; then
  : "${OUT:=$SHARED_OUT}"
fi

# Environment activation for the federation account's own clone + conda env (rebuilt from
# pyproject.toml, NOT the shared Alex binary env). CONDA_ENV_PATH uses that account's own $WORK
# inside its SLURM jobs.
# NOTE: confirm `module load python` exists on tinyx; adjust MODULE_CMD if the module name differs.
: "${MODULE_CMD:=module load python}"
: "${CONDA_ENV:=py_dl}"
: "${CONDA_ENV_PATH:=$WORK/software/private/conda/envs/py_dl}"
